diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..250e81f 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,11 +273,24 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
+#if defined(ARM64_BOARD_CONFIG_CACTUS)
+Ltrylock_enqueue_retry:
+	ldaxr	w10, [x3]
+	cbnz	w10, Ltrylock_enqueue_failed
+	stlxr	w12, w11, [x3]
+	cbnz	w12, Ltrylock_enqueue_retry
+	b	Ltrylock_enqueue_success
+Ltrylock_enqueue_failed:
+	clrex
+	mov		x0, #-1			// Failed
+	b Ltrylock_enqueue_exit
+#else
 	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_enqueue_exit
+#endif
 
 	/* We got the lock, enqueue the element */
 
@@ -323,11 +336,24 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
+#if defined(ARM64_BOARD_CONFIG_CACTUS)
+Ltrylock_dequeue_retry:
+	ldaxr	w10, [x2]
+	cbnz	w10, Ltrylock_dequeue_failed
+	stlxr	w12, w11, [x2]
+	cbnz	w12, Ltrylock_dequeue_retry
+	b	Ltrylock_dequeue_success
+Ltrylock_dequeue_failed:
+	clrex
+	mov		x0, #-1			// Failed
+	b Ltrylock_dequeue_exit
+#else
 	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
 	b Ltrylock_dequeue_exit
+#endif
 
 	/* We got the lock, dequeue the element */
 Ltrylock_dequeue_success:
