diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..5bf19a5 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1828,25 +1828,48 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #if defined(SWEET)
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
- * Use the otherwise empty 32MB block above low globals and below gVirtBase
- * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ * Map the framebuffer at an otherwise empty VA below gVirtBase so it survives
+ * bootstrap TTBR0 teardown. SWEET uses one 32MB block; CACTUS needs two 2MB
+ * blocks because its 4K KVA layout places the alias in a different L1 entry.
  */
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#if defined(CACTUS)
+#define SWEET_EARLY_FB_PA CACTUS_FB_ALIAS_PA
+#define SWEET_EARLY_FB_BLOCKS 2
+#else
+#define SWEET_EARLY_FB_PA 0x9c000000ULL
+#define SWEET_EARLY_FB_BLOCKS 1
+#endif
 
 static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
-	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
-	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+	unsigned int i;
+	assert(va + SWEET_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE <= gVirtBase);
+	tt_entry_t *l1_slot = &cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	if ((*l1_slot & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) !=
+	    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		tt_entry_t *new_l2;
+		assert(*l1_slot == ARM_TTE_EMPTY);
+		new_l2 = (tt_entry_t *)alloc_ptpage(TRUE);
+		bzero(new_l2, ARM_PGBYTES);
+		*l1_slot = (kvtophys((vm_offset_t)new_l2) & ARM_TTE_TABLE_MASK) |
+		    ARM_TTE_TYPE_TABLE | ARM_TTE_VALID | ARM_DYNAMIC_TABLE_XN |
+		    ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA);
+	}
+	tt_entry_t l1 = *l1_slot;
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
-	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (i = 0; i < SWEET_EARLY_FB_BLOCKS; i++) {
+		vm_map_address_t block_va = va + i * ARM_TT_L2_SIZE;
+		tt_entry_t *slot = &l2[(block_va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		assert(*slot == ARM_TTE_EMPTY);
+		*slot = (SWEET_EARLY_FB_PA + i * ARM_TT_L2_SIZE) |
+		    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
