diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -554,5 +554,23 @@
 	case UIO_USERSPACE64:   /* Same for copyin()... */
 		#if defined(CACTUS)
-            error = cactus_init_readstr(path, imgp->ip_strings + strlen(EXECUTABLE_KEY), len, &len);
+            if (cactus_init_shadow_ready && path >= cactus_init_scratch_start &&
+                path - cactus_init_scratch_start < cactus_init_scratch_size) {
+                size_t offset = path - cactus_init_scratch_start;
+                size_t available = cactus_init_scratch_size - offset;
+                size_t bytes = MIN(len, available);
+                const uint8_t *shadow = &cactus_init_scratch_shadow[offset];
+                const uint8_t *nul = memchr(shadow, 0, bytes);
+                if (nul == NULL) {
+                    error = bytes < len ? EFAULT : ENAMETOOLONG;
+                } else {
+                    len = (size_t)(nul - shadow) + 1;
+                    memcpy(imgp->ip_strings + strlen(EXECUTABLE_KEY), shadow, len);
+                    error = 0;
+                }
+            } else {
+                /* A bootstrap path must not invoke an unresolved early TTBR0 copyin. */
+                error = cactus_init_shadow_ready ? EFAULT :
+                    cactus_init_readstr(path, imgp->ip_strings + strlen(EXECUTABLE_KEY), len, &len);
+            }
 #else
             error = copyinstr(path, imgp->ip_strings + strlen(EXECUTABLE_KEY), len, &len);
