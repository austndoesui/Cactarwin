 }
 
+#if defined(CACTUS)
+static void *cactus_pid1_execargs_wired;
+#endif
 static kern_return_t
 execargs_purgeable_allocate(char **execarg_address)
 {
+#if defined(CACTUS)
+    proc_t proc = current_proc();
+    if (cactus_init_shadow_ready && proc != PROC_NULL && proc_pid(proc) == 1) {
+        void *buf = kalloc_data(BSD_PAGEABLE_SIZE_PER_EXEC, Z_WAITOK | Z_ZERO);
+        if (buf == NULL) return KERN_RESOURCE_SHORTAGE;
+        cactus_pid1_execargs_wired = buf;
+        *execarg_address = (char *)buf;
+        return KERN_SUCCESS;
+    }
+#endif
