  *
  * Returns 0 on success, or an error.
  */
+#if defined(CACTUS)
+/*
+ * The cactus md0 root is an IOKit virtual RAMDisk. It does not have a
+ * directly mappable physical memdev base (see patch 0024). Avoid UBC's
+ * cluster_read state machine for the first executable vnode read: that
+ * returned in Stage78 without completing the containing vn_rdwr().
+ *
+ * Mountroot already validated the same device with buf_meta_bread().
+ * Read bounded DEV_BSIZE units from that device and advance the caller's
+ * UIO exactly once per successful copy, including partial/EOF reads.
+ * Keep block-cache entries invalid so a later read never reuses stale
+ * root-device metadata.
+ */
+static int
+mockfs_cactus_devread(vnode_t vp, uio_t uio, off_t file_size)
+{
+    vnode_t dvp = vfs_devvp(vp->v_mount);
+    int error = 0;
+
+    if (dvp == NULL) {
+        return EIO;
+    }
+    while (uio_resid(uio) != 0) {
+        off_t pos = uio_offset(uio);
+        size_t inblock, amount;
+        buf_t bp = NULL;
+
+        if (pos < 0) {
+            error = EINVAL;
+            break;
+        }
+        if (pos >= file_size) {
+            break; /* EOF leaves residual unchanged for vn_rdwr. */
+        }
+        inblock = (size_t)(pos % DEV_BSIZE);
+        amount = DEV_BSIZE - inblock;
+        if ((off_t)amount > file_size - pos) {
+            amount = (size_t)(file_size - pos);
+        }
+        if (amount > (size_t)uio_resid(uio)) {
+            amount = (size_t)uio_resid(uio);
+        }
+        error = (int)buf_meta_bread(dvp, (daddr64_t)(pos / DEV_BSIZE),
+            DEV_BSIZE, NOCRED, &bp);
+        if (error == 0) {
+            error = uiomove((char *)buf_dataptr(bp) + inblock,
+                (int)amount, uio);
+        }
+        if (bp != NULL) {
+            buf_markinvalid(bp);
+            buf_brelse(bp);
+        }
+        if (error != 0) {
+            break;
+        }
+    }
+    vnode_put(dvp);
+    return error;
+}
+#endif /* CACTUS */
