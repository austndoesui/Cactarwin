 static void exec_port_actions_destroy(struct exec_port_actions *port_actions);
 
+#if defined(CACTUS)
+/* PID1's first scratch page is wired by Stage74. Read its physical alias to
+ * prepare the first exec image while early TTBR0 copyin remains unreliable. */
+extern ppnum_t pmap_find_phys(void *, uint64_t);
+extern vm_map_address_t phystokv(uint64_t);
+extern void fbcon_stage53_progress(const char *);
+static vm_map_address_t cactus_init_scratch_start;
+static vm_map_size_t cactus_init_scratch_size;
+static int cactus_init_read(void *dst, user_addr_t src, size_t n)
+{
+    proc_t proc = current_proc();
+    if (proc == PROC_NULL || proc_pid(proc) != 1 ||
+        cactus_init_scratch_start == 0 || src < cactus_init_scratch_start ||
+        src - cactus_init_scratch_start >= cactus_init_scratch_size ||
+        n > cactus_init_scratch_size - (src - cactus_init_scratch_start)) {
+        return copyin(src, dst, n);
+    }
+    uint8_t *output = dst;
+    while (n) {
+        ppnum_t ppn = pmap_find_phys(get_task_pmap(proc_task(proc)), src);
+        if (!ppn) return EFAULT;
+        vm_size_t offset = src & PAGE_MASK;
+        vm_size_t length = MIN(n, PAGE_SIZE - offset);
+        memcpy(output, (void *)(uintptr_t)(phystokv(ptoa(ppn)) + offset), length);
+        output += length;
+        src += length;
+        n -= length;
+    }
+    return 0;
+}
+static int cactus_init_readstr(user_addr_t src, char *dst, size_t limit, size_t *copied)
+{
+    for (size_t i = 0; i < limit; i++) {
+        int err = cactus_init_read(dst + i, src + i, 1);
+        if (err) { if (copied) *copied = i; return err; }
+        if (!dst[i]) { if (copied) *copied = i + 1; return 0; }
+    }
+    if (copied) *copied = limit;
+    return ENAMETOOLONG;
+}
