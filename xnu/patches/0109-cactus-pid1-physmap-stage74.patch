+++ b/bsd/kern/kern_exec.c
@@ -6749,4 +6749,46 @@
  *		initproc might be different.
  */
+#if defined(CACTUS)
+/* Bootstrap PID1 scratch bytes through the kernel physical aperture.  The
+ * first userspace task may have a valid VM map before its TTBR0 switch/fault
+ * path is ready. Wire the allocated page, then write the *mapped* page, not
+ * the unbacked user VA.  These are genuine PID1 argument bytes for execve. */
+/* The low-level ARM pmap helpers are private to XNU's pmap headers. */
+extern ppnum_t pmap_find_phys(void *, uint64_t);
+extern vm_map_address_t phystokv(uint64_t);
+
+static kern_return_t
+cactus_pid1_copy_to_map(vm_map_t map, proc_t p, vm_map_address_t dst,
+    const void *src, vm_size_t length)
+{
+    vm_map_offset_t lo = vm_map_trunc_page(dst, vm_map_page_mask(map));
+    vm_map_offset_t hi = vm_map_round_page(dst + length, vm_map_page_mask(map));
+    const uint8_t *bytes = (const uint8_t *)src;
+    if (length == 0 || dst + length < dst || hi < lo ||
+        hi - lo > vm_map_page_size(map) * 2) {
+        return KERN_INVALID_ARGUMENT;
+    }
+    kern_return_t kr = vm_map_wire_kernel(map, lo, hi,
+        VM_PROT_READ | VM_PROT_WRITE, VM_KERN_MEMORY_MLOCK, TRUE);
+    if (kr != KERN_SUCCESS) {
+        return kr;
+    }
+    while (length != 0) {
+        vm_map_offset_t offset = dst & PAGE_MASK;
+        vm_size_t chunk = MIN(length, PAGE_SIZE - offset);
+        ppnum_t page = pmap_find_phys(get_task_pmap(proc_task(p)), dst);
+        if (page == 0) {
+            return KERN_INVALID_ADDRESS;
+        }
+        void *target = (void *)(uintptr_t)(phystokv(ptoa(page)) + offset);
+        memcpy(target, bytes, chunk);
+        dst += chunk;
+        bytes += chunk;
+        length -= chunk;
+    }
+    return KERN_SUCCESS;
+}
+#endif
+
