diff --git a/pexpert/pexpert/arm64/CACTUS.h b/pexpert/pexpert/arm64/CACTUS.h
--- a/pexpert/pexpert/arm64/CACTUS.h
+++ b/pexpert/pexpert/arm64/CACTUS.h
@@ -21,12 +21,12 @@
 
 #define CACTUS                    1
 
-/* Live MediaTek framebuffer (LK atag,videolfb), 720x1440. start.s maps the
- * 4MB around it at a reserved KVA alias; the console uses that from the
+/* Stage49-verified LK OVL0 layer1, 720x1440. start.s maps the
+ * 6MB around it at a reserved KVA alias; the console uses that from the
  * first post-MMU mark until it is replaced by the final Normal-NC mapping. */
-#define CACTUS_FB_BASE            0x5e605000
+#define CACTUS_FB_BASE            0x7f4db000
 #define CACTUS_FB_ALIAS_VA        0xffffffe000200000
-#define CACTUS_FB_ALIAS_PA        0x5e600000
+#define CACTUS_FB_ALIAS_PA        0x7f400000
 #define CACTUS_FB_ALIAS_OFFSET    (CACTUS_FB_BASE - CACTUS_FB_ALIAS_PA)
 #define CACTUS_FB_WIDTH           720
 #define CACTUS_FB_HEIGHT          1440
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1829,13 +1829,13 @@
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
  * Map the framebuffer at an otherwise empty VA below gVirtBase so it survives
- * bootstrap TTBR0 teardown. SWEET uses one 32MB block; CACTUS needs two 2MB
- * blocks because its 4K KVA layout places the alias in a different L1 entry.
+ * bootstrap TTBR0 teardown. SWEET uses one 32MB block; CACTUS needs three 2MB
+ * blocks to cover the full layer1 scanout at its aligned PA offset.
  */
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 #if defined(CACTUS)
 #define SWEET_EARLY_FB_PA CACTUS_FB_ALIAS_PA
-#define SWEET_EARLY_FB_BLOCKS 2
+#define SWEET_EARLY_FB_BLOCKS 3
 #else
 #define SWEET_EARLY_FB_PA 0x9c000000ULL
 #define SWEET_EARLY_FB_BLOCKS 1
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -516,7 +516,7 @@
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
 #if defined(CACTUS)
-	MOV64	x0, (0x5e605000 + 1408 * 2880)
+	MOV64	x0, (CACTUS_FB_BASE + 1408 * CACTUS_FB_STRIDE)
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #2880
@@ -706,7 +706,7 @@
 	/*
 	 * CACTUS has 4K pages, so the framebuffer is four 2MB blocks away from
 	 * the kernel's V=P start and cannot share a free L1 entry with it.
-	 * Map the two blocks containing the console text and status rows at
+	 * Map three contiguous 2MB blocks covering the entire LCD layer1 at
 	 * CACTUS_FB_ALIAS_VA in the KVA table used by TTBR1 after MMU enable.
 	 */
 	MOV64	x0, CACTUS_FB_ALIAS_VA
@@ -719,6 +719,9 @@
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	str		x11, [x2, x12, lsl #TTE_SHIFT]
 	MOV64	x13, (ARM_TT_L2_SIZE)
+	add		x11, x11, x13
+	add		x12, x12, #1
+	str		x11, [x2, x12, lsl #TTE_SHIFT]
 	add		x11, x11, x13
 	add		x12, x12, #1
 	str		x11, [x2, x12, lsl #TTE_SHIFT]
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -101,13 +101,24 @@
 		return;
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+	/* Cactus is only 720px wide; the stage bar must not overrun a row. */
+#if defined(CACTUS)
+	if ((stage + 1) * 48 <= EARLY_WIDTH) {
+#endif
 	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
 		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
 			EARLY_FB[y * EARLY_STRIDE + x] = color;
 		}
 	}
+#if defined(CACTUS)
+	}
+#endif
 	__asm__ volatile("dsb sy" ::: "memory");
+#if defined(CACTUS)
+	sweet_early_string("CACTUS-XNU-STAGE51 ");
+#else
 	sweet_early_string("SWEET EARLY ");
+#endif
 	if (stage >= 10) {
 		sweet_early_putc((char)('0' + stage / 10));
 	}
@@ -115,6 +126,7 @@
 	sweet_early_string(": ");
 	sweet_early_string(label);
 	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
 }
 
 void
@@ -124,7 +136,11 @@
 		return;
 	}
 	early_panicking = 1;
+#if defined(CACTUS)
+	sweet_early_string("\nCACTUS-XNU-STAGE51 PANIC: ");
+#else
 	sweet_early_string("\nSWEET EARLY PANIC: ");
+#endif
 	va_list copy;
 	va_copy(copy, *args);
 	_doprnt(fmt, &copy, sweet_early_putc, 16);
