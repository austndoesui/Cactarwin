diff --git a/osfmk/kperf/kperf.c b/osfmk/kperf/kperf.c
--- a/osfmk/kperf/kperf.c
+++ b/osfmk/kperf/kperf.c
@@ -80,7 +80,14 @@
 	 * kperf allocates based on the number of CPUs and requires them to all be
 	 * accounted for.
 	 */
+#if defined(CACTUS)
+	extern void fbcon_stage53_progress(const char *);
+	fbcon_stage53_progress("ST56 CPU wait enter");
+#endif
 	ml_wait_max_cpus();
+#if defined(CACTUS)
+	fbcon_stage53_progress("ST56 CPU wait done");
+#endif
 
 	boolean_t found_kperf = FALSE;
 	char kperf_config_str[64];
diff --git a/osfmk/arm/machine_routines_common.c b/osfmk/arm/machine_routines_common.c
--- a/osfmk/arm/machine_routines_common.c
+++ b/osfmk/arm/machine_routines_common.c
@@ -1270,6 +1270,10 @@
 void
 ml_set_max_cpus(unsigned int max_cpus __unused)
 {
+#if defined(CACTUS)
+	extern void fbcon_stage53_progress(const char *);
+	fbcon_stage53_progress("ST56 CPU publish enter");
+#endif
 	lck_mtx_lock(&max_cpus_lock);
 	if (max_cpus_initialized != MAX_CPUS_SET) {
 		if (max_cpus_initialized == MAX_CPUS_WAIT) {
@@ -1278,6 +1282,9 @@
 		max_cpus_initialized = MAX_CPUS_SET;
 	}
 	lck_mtx_unlock(&max_cpus_lock);
+#if defined(CACTUS)
+	fbcon_stage53_progress("ST56 CPU publish done");
+#endif
 }
 
 unsigned int
@@ -1286,6 +1293,9 @@
 	assert(lockdown_done);
 	lck_mtx_lock(&max_cpus_lock);
 	while (max_cpus_initialized != MAX_CPUS_SET) {
+#if defined(CACTUS)
+		fbcon_stage53_progress("ST56 CPU wait sleeping");
+#endif
 		max_cpus_initialized = MAX_CPUS_WAIT;
 		lck_mtx_sleep(&max_cpus_lock, LCK_SLEEP_DEFAULT, &max_cpus_initialized, THREAD_UNINT);
 	}
diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -130,6 +130,10 @@
 	PE_parse_boot_argn("cpus", &requested, sizeof(requested));
 	IOLog("SWEET CPU: requested=%u selected=%u (limit=%u)\n",
 	    requested, topology->num_cpus, SWEET_SMP_MAX_CPUS);
+#if defined(CACTUS)
+	extern void fbcon_stage53_progress(const char *);
+	fbcon_stage53_progress("ST56 CPU startAll enter");
+#endif
 
 	uint64_t deadline;
 	nanoseconds_to_deadline(10 * NSEC_PER_SEC, &deadline);
@@ -144,16 +148,25 @@
 		}
 		IOSleep(1);
 	}
+#if defined(CACTUS)
+	fbcon_stage53_progress("ST56 CPU registered all");
+#endif
 	/* The supplied ADT has cpu0 as the boot CPU and ascending A55 nodes. */
 	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
 		panic("SWEET CPU: expected boot MPIDR 0 and logical CPU 0");
 	}
 	for (unsigned int i = 0; i < topology->num_cpus; i++) {
 		SweetCPU *cpu = __atomic_load_n(&sweet_cpus[i], __ATOMIC_ACQUIRE);
+#if defined(CACTUS)
+		fbcon_stage53_progress("ST56 CPU processor_start enter");
+#endif
 		kern_return_t kr = processor_start(cpu->machProcessor);
 		if (kr != KERN_SUCCESS) {
 			panic("SWEET CPU: cpu=%u processor_start failed: %d", i, kr);
 		}
+#if defined(CACTUS)
+		fbcon_stage53_progress("ST56 CPU processor_start done");
+#endif
 		/* processor_start() is asynchronous for secondaries in this XNU. */
 		nanoseconds_to_deadline(5 * NSEC_PER_SEC, &deadline);
 		while (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) == 0 ||
@@ -167,12 +180,21 @@
 		}
 		IOLog("SWEET CPU: cpu=%u mpidr=0x%x came alive; SGI1 OK\n",
 		    i, topology->cpus[i].phys_id);
-	}
+#if defined(CACTUS)
+		fbcon_stage53_progress("ST56 CPU ready and SGI OK");
+#endif
+	}
+#if defined(CACTUS)
+	fbcon_stage53_progress("ST56 CPU before publish");
+#endif
 	/* Publish exactly once, after every selected CPU has completed initCPU(). */
 	ml_cpu_init_completed();
 	__atomic_load_n(&sweet_cpus[topology->boot_cpu->cpu_id], __ATOMIC_ACQUIRE)->cpusRunning();
 	IOService::publishResource(gIOAllCPUInitializedKey, kOSBooleanTrue);
 	ml_set_max_cpus(topology->max_cpu_id + 1);
+#if defined(CACTUS)
+	fbcon_stage53_progress("ST56 CPU all initialized");
+#endif
 	IOLog("SWEET CPU: %u/%u CPUs initialized, SGI1 verified\n",
 	    topology->num_cpus, topology->num_cpus);
 	thread_terminate(current_thread());
